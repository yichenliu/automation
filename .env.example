# The database: PostgreSQL with pgvector. ./start.sh setup makes the platform's own and writes this line.
DATABASE_URL=
# Copy to .env. Everything has a sensible default; the AI runs on your own computer through Ollama.
PLATFORM_NAME=Keel
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b-dflash2-nvfp4
# The model that finds documents, emails and records by meaning (for the AI's answers). Empty: find by words only.
OLLAMA_EMBED_MODEL=bge-m3
# Let the model think before it answers. Off by default: on a local 27B model it multiplies the wait (minutes, not seconds).
AI_THINK=false
# How adventurous the AI is (0 careful – 1 varied). 0.6 suits designs and reading documents.
AI_TEMPERATURE=0.6
DEFAULT_TIMEZONE=Australia/Perth
# Behind a reverse proxy (nginx, Caddy, a tunnel): 1 to trust X-Forwarded-For for sign-in limits. Leave empty otherwise.
TRUST_PROXY=
CURRENCY_SYMBOL=$
# Microsoft 365 (mail and OneDrive): an Entra app with redirect URI http://localhost:5050/connect/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=organizations

# The builder thinks before designing, fixing and writing worked examples (slower, more often right first time)
AI_THINK_BUILDER=false

# Where the AI runs (app/ai_providers.py). A platform admin chooses this under Settings › AI (that comes first, and
# changes it without a restart); these are what's used until then. Empty: Ollama on this computer, at OLLAMA_URL with
# OLLAMA_MODEL.
# AI_PROVIDER: ollama | compatible (your own vLLM, SGLang, LM Studio, llama.cpp or LiteLLM server, at AI_BASE_URL) |
#   openai | anthropic | gemini | azure | mistral | groq | deepseek | xai | openrouter | together | fireworks |
#   cerebras | cohere. (openai with an AI_BASE_URL of your own is your own OpenAI-compatible server, as it always was.)
# AI_MODEL: the model's name as the provider writes it (empty for a cloud provider: the newest of its leading models).
# AI_API_KEY: the key, or put it under the provider's own name below.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# A purpose on a model (and provider) of its own: the builder on a big one, quick jobs on a small one. Empty: as above.
AI_PROVIDER_BUILDER=
AI_MODEL_BUILDER=
AI_BASE_URL_BUILDER=
AI_PROVIDER_FAST=
AI_MODEL_FAST=
AI_BASE_URL_FAST=
# Search by meaning: stays on this computer (OLLAMA_EMBED_MODEL) unless sent somewhere that has embeddings
# (AI_PROVIDER_EMBED=openai with AI_MODEL_EMBED=text-embedding-3-small, voyage, gemini, mistral, ...). vLLM serves one
# model per server: its embedding model has a server of its own (AI_BASE_URL_EMBED).
AI_PROVIDER_EMBED=
AI_MODEL_EMBED=
AI_BASE_URL_EMBED=
# Cloud providers' keys, under the names their own tools use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=
# How hard a cloud model thinks when a step thinks first: low, medium, high, xhigh, max
AI_EFFORT=xhigh
# Who chooses the platform's AI under Settings › AI (comma-separated emails). Empty: whoever made the first account.
PLATFORM_ADMINS=
# Calls at once to each server from each process (empty: 2 for Ollama, 8 for vLLM or SGLang), and the seconds a call
# may take in all, its wait for a turn included.
AI_CONCURRENCY=
AI_DEADLINE=900

# Single sign-on with the business's own identity provider (Google Workspace, Okta, Auth0, Keycloak, any OpenID
# Connect one). Its redirect URI is <BASE_URL>/login/sso/callback. People link it from Your account, or accept an
# invitation with it; it never signs anyone in by the email it claims.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=

# Connecting Xero and QuickBooks Online signs in to them, which needs the platform's own app with each (once):
# developer.xero.com and developer.intuit.com, with the redirect URI <BASE_URL>/apps/oauth/callback.
# Shopify, WooCommerce, Stripe and EasyPost are connected with their own keys under Settings › Connections.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_SANDBOX=

# The background work. ./start.sh runs the web with WORKER=0 and the worker as its own process (python -m app.worker);
# WORKER=1 runs it inside the web instead (one process, for development). A worker does the kinds of work listed
# (builder, assistant, jobs, automations, outbox, knowledge, scheduler: all by default), with this many builder turns
# and jobs at once. Several workers can run at once: each item is done by one of them, and one is the scheduler.
# WORKER_KINDS=builder,assistant,jobs,automations,outbox,knowledge,scheduler
# BUILDER_CONCURRENCY=2
# JOB_CONCURRENCY=2
